# Server
PORT=3001
SEED=1042
AGENT_TOKEN=dev-agent-token
# Lets the Cowork cards approve or reject Claude's requests, and nothing else. Must differ from AGENT_TOKEN.
COWORK_TOKEN=dev-cowork-token

# MCP server
MCP_PORT=3002
# Loopback only by default; set HOST=:: to listen on every interface
# HOST=127.0.0.1
# Requests must be addressed to localhost, 127.0.0.1 or [::1]; list extra names (a tunnel) here
# ALLOWED_HOSTS=demo.tunnel.example
API_BASE_URL=http://localhost:3001
APP_BASE_URL=http://localhost:5173
ACTING_USER_ID=U-01
